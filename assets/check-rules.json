{
  "_说明": "check_article.py 用来认出文章里“硬事实”的规则，分三层：common 每个项目都用；industries 按 kb-config.json 的 vocabularies（或 check.industries）选，一个都没选中时全部使用；项目自己的写在 kb-config.json 的 check（units、standards、certificates、ratings、patterns），另外每次核对时还会从本项目知识页里自动收集常用单位和标准前缀。规则只用来认出要核对的写法，多认一种只多一条提醒。units：数字后面的单位；standards：标准号前缀（后面跟编号）；certificates：认证名（整词、区分大小写）；ratings：规格前缀（后面跟数字，如 DN50）；patterns：其他整条正则；codes：带编号的型号系列、材料牌号等前缀（如 SS 对应 SS304），核对时显示为“编号”，大多从知识页自动收集。",
  "common": {
    "units": ["%", "°C", "°F", "℃", "℉", "mm", "cm", "m", "km", "kg", "g", "t", "MPa", "kPa", "Pa", "bar", "psi", "N", "kN", "N·m", "Nm",
              "in", "inch", "inches", "\"", "ft", "V", "kV", "A", "mA", "W", "kW", "Hz", "kHz", "m³/h", "m3/h", "L/min", "L", "ml",
              "month", "months", "year", "years", "day", "days", "hour", "hours", "h", "min", "s", "pcs", "sets", "set", "tons", "ton",
