    "standards": ["ISO", "EN", "EN ISO", "IEC", "DIN", "BS", "BS EN", "ANSI", "ASTM", "GB", "GB/T", "JIS", "UL", "NSF", "SAE"],
    "certificates": ["CE", "RoHS", "REACH", "FDA", "UL", "SGS", "TÜV", "TUV", "BV", "ISO 9001", "ISO 14001", "ISO 45001"],
    "ratings": [],
    "patterns": []
